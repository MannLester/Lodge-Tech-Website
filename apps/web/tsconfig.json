{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "noEmit": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@/features/*": ["./src/features/*"],
      "@/components/*": ["./src/components/*"],
      "@/app/*": ["./src/app/*"],
      "@lodging-technologies/types": ["../../packages/types/src/index.ts"],
      "@lodging-technologies/types/*": ["../../packages/types/src/*"],
      "@lodging-technologies/ui": ["../../packages/ui/src/index.ts"],
      "@lodging-technologies/ui/*": ["../../packages/ui/src/*"],
      "@lodging-technologies/zod-schemas": [
        "../../packages/zod-schemas/src/index.ts"
      ],
      "@lodging-technologies/zod-schemas/*": [
        "../../packages/zod-schemas/src/*"
      ]
    },
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo"
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
