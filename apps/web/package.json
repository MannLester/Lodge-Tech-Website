{
  "name": "@lodging-technologies/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node -e \"fs.rmSync('.next', { recursive: true, force: true })\"",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "pnpm -C ../.. exec eslint apps/web",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src package.json next.config.js postcss.config.mjs",
    "test": "vitest run --config ../../vitest.config.ts apps/web/src",
    "test:watch": "vitest --config ../../vitest.config.ts apps/web/src",
    "test:e2e": "playwright test --config ../../playwright.config.ts"
  },
  "dependencies": {
    "@lodging-technologies/types": "workspace:*",
    "@lodging-technologies/ui": "workspace:*",
    "@lodging-technologies/zod-schemas": "workspace:*",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.114.0",
    "@vercel/analytics": "^2.0.1",
    "jose": "^6.2.10",
    "lucide-react": "^0.390.0",
    "next": "^14.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "zod": "^3.23.0"
  }
}
