{
  "name": "lodge-tech-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "next dev",
    "build": "turbo run //#build:app",
    "build:app": "next build",
    "db:test": "supabase test db",
    "start": "next start",
    "lint": "turbo run //#lint:app",
    "lint:app": "eslint .",
    "typecheck": "turbo run //#typecheck:app",
    "typecheck:app": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "turbo run //#format:check:app",
    "format:check:app": "prettier --check .",
    "test": "turbo run //#test:unit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "turbo run //#test:e2e:app",
    "test:e2e:app": "playwright test",
    "check": "turbo run //#lint:app //#typecheck:app //#format:check:app //#test:unit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.114.0",
    "jose": "^6.2.10",
    "lucide-react": "1.39.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.0.1",
    "postcss": "^8.5.28",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "^2.116.0",
    "tailwindcss": "4.3.3",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
