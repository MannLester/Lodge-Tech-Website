{
  "name": "@lodging-technologies/types",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./database": "./src/database.ts"
  },
  "scripts": {
    "clean": "node -e \"['dist', 'build', '*.tsbuildinfo'].forEach(p => fs.rmSync(p, { recursive: true, force: true, glob: true }))\"",
    "build": "tsc -b",
    "lint": "pnpm -C ../.. exec eslint packages/types",
    "typecheck": "tsc -b --pretty false",
    "format:check": "prettier --check src package.json"
  }
}
